generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Route {
  id              String  @id
  route_short_name String?
  route_long_name  String?
  route_desc       String?
  route_type      Int?
  route_color     String?
  route_text_color String?
  
  trips           Trip[]
  fare_rules      FareRule[]
}

model Trip {
  id            String  @id @default(cuid())
  route_id      String
  service_id    String?
  trip_headsign String?
  direction_id  Int?
  shape_id      String?

  route      Route      @relation(fields: [route_id], references: [id])
  stop_times StopTime[]
  frequencies Frequency[]

  @@index([route_id])
}

model Frequency {
  id           String @id @default(cuid())
  trip_id      String
  start_time   String
  end_time     String
  headway_secs Int
  exact_times  Int?

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
}

model Stop {
  id            String  @id
  stop_name     String
  stop_lat      Float
  stop_lon      Float
  location_type Int?

  stop_times StopTime[]
}

model StopTime {
  id            String @id @default(cuid())
  trip_id       String
  arrival_time  String?
  departure_time String?
  stop_id       String
  stop_sequence Int

  trip Trip @relation(fields: [trip_id], references: [id])
  stop Stop @relation(fields: [stop_id], references: [id])

  @@index([trip_id])
  @@index([stop_id])
}

model Shape {
  id                String @id @default(cuid())
  shape_id          String
  shape_pt_lat      Float
  shape_pt_lon      Float
  shape_pt_sequence Int

  @@index([shape_id])
}

model FareAttribute {
  fare_id           String  @id
  price             Float
  currency_type     String
  payment_method    Int
  transfers         Int?
  agency_id         String?
  transfer_duration Int?

  rules FareRule[]
}

model FareRule {
  id        String @id @default(cuid())
  fare_id   String
  route_id  String

  fare_attribute FareAttribute @relation(fields: [fare_id], references: [fare_id])
  route          Route         @relation(fields: [route_id], references: [id])

  @@index([route_id])
  @@index([fare_id])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  
  bookmarks Bookmark[]
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  description String
  startLat    Float
  startLon    Float
  startName   String
  destLat     Float
  destLon     Float
  destName    String
  time        String?
  vehicle     String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
